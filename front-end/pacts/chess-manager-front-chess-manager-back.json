{
  "consumer": {
    "name": "chess-manager-front"
  },
  "interactions": [
    {
      "description": "a request for the clubs of a committee",
      "pending": false,
      "providerStates": [
        {
          "name": "the committee 45 has the club G45100"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/clubs",
        "query": {
          "committee": [
            "45"
          ]
        }
      },
      "response": {
        "body": {
          "content": [
            {
              "commune": "Montargis",
              "ffeClubId": "G45100",
              "id": "6f1c1c7e-3c1a-4b0e-9d4e-2b7a5f0c8a11",
              "name": "Echiquier du Gâtinais"
            }
          ],
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request for the communes of a committee",
      "pending": false,
      "request": {
        "method": "GET",
        "path": "/api/communes",
        "query": {
          "committee": [
            "45"
          ]
        }
      },
      "response": {
        "body": {
          "content": [
            {
              "code": "45232",
              "name": "Olivet"
            }
          ],
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "chess-manager-back"
  }
}