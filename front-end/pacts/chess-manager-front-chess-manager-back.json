{
  "consumer": {
    "name": "chess-manager-front"
  },
  "interactions": [
    {
      "description": "a request for the communes of a committee",
      "pending": false,
      "request": {
        "method": "GET",
        "path": "/communes",
        "query": {
          "committee": [
            "45"
          ]
        }
      },
      "response": {
        "body": {
          "content": [
            {
              "code": "45232",
              "name": "Olivet"
            }
          ],
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
